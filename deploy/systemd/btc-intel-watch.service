[Unit]
Description=BTC intelligence: health check
Documentation=file:///opt/btc-intel/docs/production-collection.md
OnFailure=btc-intel-alert@%n.service

[Service]
Type=oneshot
User=btc-intel
Group=btc-intel
StateDirectory=btc-intel
Environment=BTC_INTEL_STATE_ROOT=%S/btc-intel
Environment=PYTHONPATH=/opt/btc-intel
# The profile check needs the contact the collector needs.
EnvironmentFile=-/etc/btc-intel/collector.env
WorkingDirectory=/opt/btc-intel

# 0 healthy, 1 warning, 2 critical. A warning -- a backup a few days old, one
# quiet provider -- is logged for the morning and is not an alert: a watchdog
# that pages for everything is a watchdog that gets muted. Critical fails the
# unit, and OnFailure raises the alert.
ExecStart=/opt/btc-intel/.venv/bin/python /opt/btc-intel/btc-intel.py --db %S/btc-intel/intelligence.duckdb ops-watch --json --profile /opt/btc-intel/deploy/collection-profile.json
SuccessExitStatus=1
TimeoutStartSec=300

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX
