[Unit]
Description=BTC intelligence: collect on a fixed cadence
Documentation=file:///opt/btc-intel/deploy/DEPLOYMENT.md

[Timer]
# Every three hours. This number is not arbitrary and is worth defending,
# because it is decided once and cannot be revisited later: `available_at` is
# retrieval time, so the cadence sets a floor under how sharply any future event
# study can place an announcement, and a corpus collected coarsely cannot be
# re-collected finely.
#
#   at 12h: mean lag 6.0h, worst 12h -- 25% of a 24h horizon, 14 fetches/day
#   at  6h: mean lag 3.0h, worst  6h -- 12.5%,                  28 fetches/day
#   at  3h: mean lag 1.5h, worst  3h -- 6.2%,                   56 fetches/day
#
# A 168h horizon tolerates any of these. A 24h horizon does not: at 12 hours a
# quarter of the horizon is retrieval lag. 56 requests a day across seven
# government feeds is a rounding error to the publishers and well inside the
# 900s floor the provider declares, so the politeness argument does not buy
# anything the coarser setting costs.
OnCalendar=*-*-* 00/3:07:00

# Seven minutes past, then up to five more: nothing is gained by arriving at the
# top of the hour with everyone else's cron.
RandomizedDelaySec=300
AccuracySec=1m

# The point of the whole deployment is an unbroken record. A host that was off
# at 03:07 collects as soon as it is back rather than silently skipping, and the
# gap in the corpus is one cycle instead of one day.
Persistent=true

[Install]
WantedBy=timers.target
