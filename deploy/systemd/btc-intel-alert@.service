[Unit]
Description=BTC intelligence: raise an alert for %i
Documentation=file:///opt/btc-intel/docs/production-collection.md
# Deliberately no OnFailure here: an alert that fails to send must not raise an
# alert about itself, forever. Its failure is still in `systemctl --failed`.

[Service]
Type=oneshot
User=btc-intel
Group=btc-intel
Environment=PYTHONPATH=/opt/btc-intel
# BTC_INTEL_ALERT_COMMAND, if the operator set one. Absent is fine: the alert
# is written to the journal at CRITICAL either way.
EnvironmentFile=-/etc/btc-intel/collector.env
WorkingDirectory=/opt/btc-intel
ExecStart=/opt/btc-intel/.venv/bin/python /opt/btc-intel/btc-intel.py ops-alert --unit %i
TimeoutStartSec=120

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# An alert command may mail or post, so this one unit may reach the network.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
