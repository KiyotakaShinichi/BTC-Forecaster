[Unit]
Description=BTC intelligence: back up the accumulated corpus
Documentation=file:///opt/btc-intel/deploy/DEPLOYMENT.md
OnFailure=btc-intel-alert@%n.service

[Service]
Type=oneshot
User=btc-intel
Group=btc-intel
StateDirectory=btc-intel
Environment=BTC_INTEL_STATE_ROOT=%S/btc-intel
Environment=PYTHONPATH=/opt/btc-intel
WorkingDirectory=/opt/btc-intel

# The corpus is the one thing here that cannot be rebuilt. Code can be cloned
# again and a host reinstalled; a document that was available at 09:00 on a
# Tuesday in March can never be re-collected with that availability, because
# `available_at` is when we retrieved it and we cannot retrieve it then again.
#
# ops-backup takes the collector's run lock -- waiting up to ten minutes for a
# running cycle -- archives, proves the archive by restoring it into a
# scratch location and checking it, and only then prunes to the newest 30.
# Every attempt is recorded where the health check reads it. 3 means a cycle
# held the lock for the whole wait; tomorrow's run takes the backup, and a
# backup older than seven days is a warning either way.
ExecStart=/opt/btc-intel/.venv/bin/python /opt/btc-intel/btc-intel.py ops-backup --retain 30 --wait-seconds 600
SuccessExitStatus=3
TimeoutStartSec=1800

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
