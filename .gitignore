# Must stay UTF-8. Git reads this file as bytes, so a UTF-16 save makes every
# rule below silently inert -- it looks correct in an editor and ignores nothing.
# Verify changes with `git check-ignore -v <path>`, not by reading it.
__pycache__/
*.pyc
*.png
# Generated datasets. `btc-intel replay-dataset --format csv` writes here too:
# build outputs are reproducible from the manifest and do not belong in git.
*.csv
.coverage
# B4 market-data cache. 28MB of raw third-party quotes: Yahoo's terms do not
# grant redistribution, and the cache is rebuildable from the run manifest's
# series fingerprints. Only derived statistics are committed.
research/market_intelligence/b4/cache/
# B4 row-level target file. It carries raw BTC closes, which Yahoo's terms do
# not grant redistribution of; its sha256 is recorded in the run manifest so a
# regenerated copy can be checked against the published run. See the README in
# each run directory.
research/market_intelligence/b4/runs/*/targets.json
# Generated DuckDB store for the B4.39 feature-matrix demonstration.
research/market_intelligence/b4/feature_matrix/*.duckdb
