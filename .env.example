# BTC-Forecaster -- environment template
#
# Copy to `.env` and fill in what you need:  cp .env.example .env
# `.env` is gitignored. Never commit a filled-in copy.
#
# IMPORTANT: nothing in this repository reads `.env` automatically. There is no
# dotenv loader, deliberately -- a process whose configuration depends on a file
# it silently picked up is a process nobody can reproduce. Load it explicitly:
#
#   POSIX:    set -a; . ./.env; set +a
#   compose:  services.<name>.env_file: .env
#   systemd:  EnvironmentFile=/etc/btc-intel/collector.env
#
# Every variable below is OPTIONAL unless its block says otherwise. The
# quantitative CLI is flag-driven and reads none of these; the variables it
# honours exist so the Docker images and the older shell scripts keep working.
#
# Four categories, and they are not interchangeable:
#
#   REQUIRED         the process refuses to start without it
#   OPTIONAL         changes behaviour; has a documented default
#   DEPLOYMENT-ONLY  only meaningful on a host that runs a service
#   RESEARCH-ONLY    only affects what a research run computes
#
# ============================================================================
# COLLECTOR -- market intelligence  (DEPLOYMENT-ONLY)
# ============================================================================

# REQUIRED, for the collector only.
#
# Goes into the User-Agent of every feed request as:
#   BTC-Forecaster Research <this address>
#
# Not decoration. The SEC's access policy asks automated clients to identify
# themselves with a contact and answers 403 to those that do not. One manual
# fetch slips through; a collector polling eight times a day for months is
# exactly what gets blocked -- weeks later, as a PERMANENT failure on a feed
# everyone assumed was working.
#
# Use a dedicated project address, not a personal one. The collector refuses to
# start when the profile asks for this and it is unset, rather than advertising
# an unexpanded placeholder.
BTC_INTEL_CONTACT=you@example.org

# OPTIONAL. Where the corpus lives. Default: ./btc-intel-state
#
# The collector refuses to start on a root it cannot prove is writable, and
# warns loudly when the root looks ephemeral: a corpus under /tmp ends at the
# next reboot, and an availability record cannot be re-collected after the fact.
# systemd sets this to its StateDirectory; normally leave it alone.
# BTC_INTEL_STATE_ROOT=/var/lib/btc-intel

# OPTIONAL. Individual paths, so a fast disk for the database and a large one
# for backups is not a choice between them. Each defaults to a child of
# BTC_INTEL_STATE_ROOT.
# BTC_INTEL_DATABASE=/var/lib/btc-intel/intelligence.duckdb
# BTC_INTEL_MANIFEST_DIR=/var/lib/btc-intel/manifests
# BTC_INTEL_CORPUS_DIR=/var/lib/btc-intel/corpus
# BTC_INTEL_BACKUP_DIR=/mnt/backup/btc-intel
# BTC_INTEL_LOG_DIR=/var/lib/btc-intel/logs
# BTC_INTEL_LOCK_FILE=/var/lib/btc-intel/collector.lock

# OPTIONAL. Recorded in every collection manifest so a corpus can name the code
# that produced it. `deploy/install.sh` sets it from the deployed checkout.
# BTC_INTEL_SOURCE_SHA=

# OPTIONAL. Verbosity of the structured JSON log the collector writes to stderr,
# where systemd's journal picks it up. One of DEBUG / INFO / WARNING / ERROR;
# INFO is the default and is what makes per-provider outcomes visible. DEBUG
# adds nothing today and is accepted so a host can turn it up without a deploy.
#
# Read `journalctl -u btc-intel-collect -o cat | jq` -- every line is one JSON
# object, and no credential or contact address can appear in one: fields named
# like a secret are dropped, and configured secret *values* are scrubbed out of
# every remaining field, because an address reaches a log through `detail` far
# more easily than through a field somebody called `contact`.
# BTC_INTEL_LOG_LEVEL=INFO

# OPTIONAL, and normally absent. Credentials for licensed providers.
#
# Setting one does not enable its provider -- the collection profile has to name
# it too -- and an unset variable is reported as "not enabled", never guessed at
# or defaulted. The default deployment collects from public government feeds and
# needs no credential at all, which is a property worth keeping: a collector
# with no secret cannot leak one.
# BTC_INTEL_SEARCH_API_KEY=
# BTC_INTEL_STATEMENTS_API_KEY=
# BTC_INTEL_WHALE_API_KEY=

# ============================================================================
# API AND DASHBOARD -- api_server.py  (DEPLOYMENT-ONLY)
# ============================================================================

# OPTIONAL. When set, every request must carry it as an `X-API-Key` header.
# Unset means the API is unauthenticated -- correct for localhost, wrong for
# anything reachable.
# API_TOKEN=change-me

# OPTIONAL. Bind address and port. Default: 0.0.0.0:8010
# APP_HOST=0.0.0.0
# APP_PORT=8010

# OPTIONAL. Development conveniences, both off in a deployment.
# APP_RELOAD=0
# APP_AUTO_OPEN=0

# OPTIONAL. Confines any `output_dir` a request asks for. Defaults to
# OUTPUT_DIR, which is the safe choice; widen it only deliberately.
# ALLOWED_OUTPUT_ROOT=/app/out

# OPTIONAL. Upload run artifacts to S3 after a successful run. Leave the bucket
# empty to keep artifacts local. Credentials come from the standard AWS chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_PROFILE, or an instance
# role); this repository never reads them itself and never writes them down.
# S3_ARTIFACT_BUCKET=
# S3_ARTIFACT_PREFIX=btc-forecaster
# S3_REGION=us-east-1

# ============================================================================
# FORECAST RUNS -- btc_forecaster  (RESEARCH-ONLY)
# ============================================================================
#
# `btc-forecast` is flag-driven and ignores all of these; `RunConfig.from_env()`
# reads them, which is how the Docker images are configured. Every one is
# recorded in the run manifest, so a result can name the settings that produced
# it. Changing any of them changes what the numbers mean.

# OPTIONAL. Where a run writes, and where pinned data snapshots are read from.
# OUTPUT_DIR=out
# SNAPSHOT_DIR=data/snapshots

# OPTIONAL. What is forecast, and from when.
# TICKER=BTC-USD
# DATA_START=2017-01-01
# HORIZON_DAYS=365
# INTERVAL_LEVEL=0.95

# OPTIONAL. Which models run, which one forecasts forward, and which one skill
# is measured against. BASELINE_MODEL must appear in MODELS -- skill cannot be
# measured against a model that was never scored.
# MODELS=random_walk,random_walk_drift,historical_mean_return,arima,ets,prophet,prophet_xgb_hybrid
# PRIMARY_MODEL=prophet_xgb_hybrid
# BASELINE_MODEL=random_walk

# OPTIONAL. Walk-forward evaluation. WF_MODE is `expanding` or `rolling`;
# WF_WINDOW_BARS applies to rolling only. WF_EMBARGO_BARS drops bars between
# train and test.
# WF_FOLDS=6
# WF_HORIZON=30
# WF_MIN_TRAIN_BARS=730
# WF_MODE=expanding
# WF_WINDOW_BARS=0
# WF_EMBARGO_BARS=0

# OPTIONAL. Determinism and cost. RANDOM_STATE is the seed every stochastic
# component derives from; changing it changes the result legitimately, so it is
# recorded in the manifest.
# RANDOM_STATE=42
# MONTE_CARLO_RUNS=1000
# MAX_LAG=60

# OPTIONAL. Data and figures. REFRESH_DATA=1 re-fetches instead of reading the
# hash-verified snapshot -- deliberate opt-in, because yfinance returns a
# slightly different series every day and silently revises history.
# REFRESH_DATA=0
# MAKE_PLOTS=1
# PLOT_SHOW=0
